# Local development environment variables for Academia
# Copy this file to .env and update the values before starting the server.

# Required
JWT_SECRET=change-this-to-a-random-secret
APP_BASE_URL=http://localhost:3000
NODE_ENV=development

# Database — PostgreSQL connection string (Supabase or other PostgreSQL provider)
# Example for local PostgreSQL: postgresql://postgres@localhost:5432/academia?sslmode=disable
# For Supabase: postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Optional: passwords that trigger "force change password" prompt (comma-separated)
DEFAULT_PASSWORDS=

# Optional: password assigned to newly created admin on first run
DEFAULT_ADMIN_PASSWORD=

# Optional: SMTP for email (MFA, password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@academia.local
SMTP_SECURE=false
